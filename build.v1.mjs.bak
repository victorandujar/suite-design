    <a href="#" style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;
       font-size:13px;font-weight:600;color:#fff;background:${SB};box-shadow:0 6px 14px -8px rgba(37,99,235,.6)">1</a>
    <a href="#" style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;color:var(--s500)">2</a>
    <a href="#" style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;color:var(--s500)">3</a>
    <button class="btn btn-ghost" style="height:34px;padding:0 11px;gap:6px">Next${ic("right", 15, 1.9)}</button>
  </div>
</div>`,
});
writeFileSync("Projects.dc.html", projects);
console.log("Projects.dc.html", projects.length);

/* ═══════════════════════════════════════════════════════════════
   CHARTS — hand-drawn SVG. Palettes validated with the dataviz
   validator (all six checks PASS, light mode).
     dispatch : charge #0891B2 / discharge #1D4ED8
     revenue  : contracted #AF47B2 / merchant #6366F1
   ═══════════════════════════════════════════════════════════════ */
const GRID = "rgba(30,58,138,.07)", AXIS = "#5F6C82";

/* rounded 4px data-end anchored to the baseline */
function bar(x, y, w, h, r, up) {
  const rr = Math.min(r, h, w / 2);
  if (h <= 0.4) return "";
  return up
    ? `M${x} ${y + h}L${x} ${y + rr}Q${x} ${y} ${x + rr} ${y}L${x + w - rr} ${y}Q${x + w} ${y} ${x + w} ${y + rr}L${x + w} ${y + h}Z`
    : `M${x} ${y}L${x} ${y + h - rr}Q${x} ${y + h} ${x + rr} ${y + h}L${x + w - rr} ${y + h}Q${x + w} ${y + h} ${x + w} ${y + h - rr}L${x + w} ${y}Z`;
}

const legend = (items) => `
<div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
  ${items.map(([label, color]) => `
    <span style="display:inline-flex;align-items:center;gap:7px">
      <i style="width:9px;height:9px;border-radius:3px;background:${color};display:block;flex:none"></i>
      <span style="font-size:12px;font-weight:500;color:var(--s500)">${label}</span>
    </span>`).join("")}
</div>`;

function dispatchChart() {
  const CHARGE = "#5B8DEF", DISCHARGE = "#1D4ED8";
  const v = [-40,-55,-60,-50,-30,-10,0,25,60,45,15,-25,-70,-85,-80,-45,0,20,70,95,100,65,20,-15];
  const W = 486, H = 208, L = 40, R = 8, T = 16, B = 24;
  const pw = W - L - R, ph = H - T - B, mid = T + ph / 2, dom = 110;
  const y = (val) => mid - (val / dom) * (ph / 2);
  const band = pw / 24, bw = 12.5;

  const grids = [100, 50, -50, -100].map((g) =>
    `<line x1="${L}" y1="${y(g).toFixed(1)}" x2="${W - R}" y2="${y(g).toFixed(1)}" stroke="${GRID}" stroke-width="1"/>`).join("");
  const ylabs = [[100, "100"], [0, "0"], [-100, "−100"]].map(([g, t]) =>
    `<text x="${L - 8}" y="${(y(g) + 3.4).toFixed(1)}" text-anchor="end" font-size="9.5" fill="${AXIS}">${t}</text>`).join("");
  const bars = v.map((val, i) => {
    if (val === 0) return "";
    const x = L + i * band + (band - bw) / 2, up = val > 0;
    const h = Math.abs(y(val) - mid), top = up ? y(val) : mid;
    return `<path class="mk" d="${bar(x, top, bw, h, 4, up)}" fill="${up ? DISCHARGE : CHARGE}"><title>${String(i).padStart(2,"0")}:00 — ${up ? "discharging" : "charging"} ${Math.abs(val)} MW</title></path>`;
  }).join("");
  const xlabs = [0, 6, 12, 18].map((i) =>
    `<text x="${(L + i * band + band / 2).toFixed(1)}" y="${H - 7}" text-anchor="middle" font-size="9.5" fill="${AXIS}">${String(i).padStart(2,"0")}:00</text>`).join("");
  const peak = L + 20 * band + band / 2;

  return `
<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block" role="img" aria-label="Hourly dispatch profile, charging and discharging power in MW">
  <style>.mk{transition:opacity .12s} .mk:hover{opacity:.8}</style>
  ${grids}${ylabs}
  <line x1="${L}" y1="${mid}" x2="${W - R}" y2="${mid}" stroke="rgba(30,58,138,.17)" stroke-width="1"/>
  ${bars}
  <text x="${peak.toFixed(1)}" y="${(y(100) - 6).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="600" fill="#0F172A">100 MW</text>
  ${xlabs}
</svg>`;
}

function revenueChart() {
  const CONTRACTED = "#7B2D80", MERCHANT = "#C74FC9";
  const d = [[2026,5.2,3.2],[2027,5.2,3.6],[2028,5.2,3.9],[2029,5.2,3.7],[2030,5.2,4.2],
             [2031,2.6,6.3],[2032,0,8.6],[2033,0,8.3],[2034,0,8.0],[2035,0,7.6]];
  const W = 486, H = 208, L = 40, R = 8, T = 18, B = 24;
  const pw = W - L - R, ph = H - T - B, dom = 10;
  const y = (val) => T + ph - (val / dom) * ph;
  const band = pw / d.length, bw = 25;

  const grids = [10, 5, 0].map((g) =>
    `<line x1="${L}" y1="${y(g).toFixed(1)}" x2="${W - R}" y2="${y(g).toFixed(1)}" stroke="${g === 0 ? "rgba(30,58,138,.17)" : GRID}" stroke-width="1"/>
     <text x="${L - 8}" y="${(y(g) + 3.4).toFixed(1)}" text-anchor="end" font-size="9.5" fill="${AXIS}">${g === 0 ? "0" : "€" + g + "M"}</text>`).join("");

  const bars = d.map(([yr, c, m], i) => {
    const x = L + i * band + (band - bw) / 2;
    const base = y(0);
    const hc = base - y(c);
    const topM = y(c + m), hm = y(c) - topM - (c > 0 ? 2 : 0); /* 2px surface gap between segments */
    const cSeg = c > 0 ? `<path class="mk" d="${bar(x, base - hc, bw, hc, m > 0 ? 0 : 4, true)}" fill="${CONTRACTED}"><title>${yr} — contracted (PPA) €${c.toFixed(1)}M</title></path>` : "";
    const mSeg = m > 0 ? `<path class="mk" d="${bar(x, topM, bw, hm, 4, true)}" fill="${MERCHANT}"><title>${yr} — merchant €${m.toFixed(1)}M</title></path>` : "";
    return cSeg + mSeg;
  }).join("");

  const xlabs = d.map(([yr], i) =>
    `<text x="${(L + i * band + band / 2).toFixed(1)}" y="${H - 7}" text-anchor="middle" font-size="9.5" fill="${AXIS}">’${String(yr).slice(2)}</text>`).join("");
  const first = L + band / 2;

  return `
<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block" role="img" aria-label="Revenue forecast by year, contracted and merchant, in millions of euros">
  <style>.mk{transition:opacity .12s} .mk:hover{opacity:.8}</style>
  ${grids}${bars}
  <text x="${first.toFixed(1)}" y="${(y(8.4) - 7).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="600" fill="#0F172A">€8.4M</text>
  ${xlabs}
</svg>`;
}

const chartWell = ({ title, note, source, legendItems, svg }) => `
<div class="l3" style="padding:16px 18px 12px;flex:1;min-width:0">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
    <div style="min-width:0">
      <div class="t-card" style="font-size:15px">${title}</div>
      <div class="t-meta" style="margin-top:3px">${note}</div>
    </div>
    ${source}
  </div>
  <div style="margin-top:12px">${legend(legendItems)}</div>
  <div style="margin-top:8px">${svg}</div>
</div>`;

