/* ═══════════════════════════════════════════════════════════════
   SCREEN 5 — Embedded cross-product workflow
   §25 §26 §32 — the parent owns the modal, focus, close, fallback
   and the post-save refresh; the product owns its content.
   That split is drawn literally: Suite glass around a body rendered
   in Revenew's own visual language (white, slate, DM Sans, 6px radii
   — lifted from sunveon-revenew-frontend). §39.1: the words iframe,
   embed and remote never reach the user.
   ═══════════════════════════════════════════════════════════════ */
const REVCSS = `
.rev{font-family:'DM Sans',system-ui,sans-serif;background:#fff;color:#0f172a}
.rev .lab{display:block;font-size:12px;font-weight:500;color:#475569;margin-bottom:6px}
.rev .fld{display:flex;align-items:center;height:36px;padding:0 11px;border:1px solid #e2e8f0;border-radius:6px;
  background:#fff;font-size:13px;color:#0f172a;gap:8px}
.rev .fld .unit{margin-left:auto;padding-left:9px;border-left:1px solid #e2e8f0;color:#94a3b8;font-size:12px;align-self:stretch;display:flex;align-items:center}
.rev .fld .chev{margin-left:auto;color:#94a3b8;display:flex}
.rev .help{display:block;font-size:11px;color:#94a3b8;margin-top:5px}
.rev .rbtn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:32px;padding:0 12px;
  border-radius:6px;font-size:13px;font-weight:500;font-family:inherit;border:1px solid transparent;cursor:pointer}
.rev .rbtn-sec{background:#fff;color:#0f172a;border-color:#e2e8f0}
.rev .rbtn-ghost{background:transparent;color:#475569}
.rev .rule{height:1px;background:#f1f5f9}
`;

function priceCurve() {
  const v = [78, 74, 66, 58, 52, 61, 79, 84, 72, 68, 76, 88];
  const M = ["J","F","M","A","M","J","J","A","S","O","N","D"];
  const W = 660, H = 292, L = 40, R = 10, T = 16, B = 26;
  const pw = W - L - R, ph = H - T - B, lo = 40, hi = 100;
  const x = (i) => L + (i / (v.length - 1)) * pw;
  const y = (val) => T + ph - ((val - lo) / (hi - lo)) * ph;

  const grids = [100, 80, 60, 40].map((g) =>
    `<line x1="${L}" y1="${y(g).toFixed(1)}" x2="${W - R}" y2="${y(g).toFixed(1)}" stroke="#f1f5f9" stroke-width="1"/>
     <text x="${L - 8}" y="${(y(g) + 3.4).toFixed(1)}" text-anchor="end" font-size="9.5" fill="#94a3b8">${g}</text>`).join("");
  const line = v.map((val, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(val).toFixed(1)}`).join("");
  const area = `${line}L${x(v.length - 1).toFixed(1)} ${(T + ph).toFixed(1)}L${L} ${(T + ph).toFixed(1)}Z`;
  /* markers double as the editor's drag handles */
  const dots = v.map((val, i) =>
    `<circle cx="${x(i).toFixed(1)}" cy="${y(val).toFixed(1)}" r="4" fill="#fff" stroke="#AF47B2" stroke-width="2"><title>${M[i]} — €${val}/MWh</title></circle>`).join("");
  const labs = M.map((m, i) =>
    `<text x="${x(i).toFixed(1)}" y="${H - 8}" text-anchor="middle" font-size="9.5" fill="#94a3b8">${m}</text>`).join("");

  return `
<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block" role="img" aria-label="Monthly capture price curve, euros per megawatt hour">
  <defs><linearGradient id="pcf" x1="0" y1="${T}" x2="0" y2="${T + ph}" gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color="#AF47B2" stop-opacity=".16"/><stop offset="1" stop-color="#AF47B2" stop-opacity="0"/>
  </linearGradient></defs>
  ${grids}
  <path d="${area}" fill="url(#pcf)"/>
  <path d="${line}" fill="none" stroke="#AF47B2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  ${dots}${labs}
  <text x="${L - 8}" y="${T + 4}" text-anchor="end" font-size="9" fill="#94a3b8">€/MWh</text>
</svg>`;
}

const revField = (label, value, { unit, chev, help } = {}) => `
<div>
  <span class="lab">${label}</span>
  <div class="fld"><span>${value}</span>${unit ? `<span class="unit">${unit}</span>` : ""}${chev ? `<span class="chev">${ic("down", 15, 1.8)}</span>` : ""}</div>
  ${help ? `<span class="help">${help}</span>` : ""}
</div>`;

const curveModal = () => `
<div style="position:absolute;inset:0;background:rgba(23,42,86,.34);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);z-index:10"></div>
<div class="l2" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:1040px;z-index:11;overflow:hidden;
     box-shadow:0 44px 110px -34px rgba(30,58,138,.44), 0 14px 36px -18px rgba(30,58,138,.22), inset 0 1px 0 rgba(255,255,255,.85)">

  <!-- parent chrome: title, context, fallback, close -->
  <div style="display:flex;align-items:center;gap:16px;padding:15px 20px;border-bottom:1px solid var(--hair)">
    <div style="flex:1;min-width:0">
      <div class="t-card" style="font-size:16px">Edit forecast curve</div>
      <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
        <span class="t-meta">Valencia BESS · Base case 2026</span>${src("revenew")}
      </div>
    </div>
    <button class="btn btn-secondary" style="height:34px">Open in Revenew${ic("upRight", 14, 1.8)}</button>
    <button class="btn btn-ghost btn-icon" style="height:34px;width:34px" aria-label="Close">
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5.4 5.4l9.2 9.2M14.6 5.4l-9.2 9.2"/></svg>
    </button>
  </div>

  <!-- the product's own surface -->
  <div class="rev" style="display:flex;align-items:stretch;gap:0">
    <div style="width:290px;flex:none;padding:20px;border-right:1px solid #f1f5f9;display:flex;flex-direction:column;gap:15px">
      ${revField("Scenario", "Base case 2026", { chev: true })}
      ${revField("Market", "Spain (ES)", { chev: true })}
      ${revField("Resolution", "Hourly", { chev: true })}
      ${revField("Annual escalation", "2.0", { unit: "%/yr", help: "Applied from 2027 onwards" })}
      <div class="rule" style="margin:3px 0"></div>
      <div style="font-size:11px;color:#94a3b8;line-height:1.6">
        8,760 points · shaped from the ES hourly profile.<br>Drag a monthly handle to reshape the curve.
      </div>
      <div style="flex:1"></div>
      <button class="rbtn rbtn-sec" style="width:100%">Reset to market shape</button>
    </div>
    <div style="flex:1;min-width:0;padding:18px 20px 12px">
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
        <div>
          <div style="font-size:14px;font-weight:600;color:#0f172a">Monthly capture price</div>
          <div style="font-size:11px;color:#94a3b8;margin-top:3px">Base case 2026 · unsaved changes</div>
        </div>
        <div style="display:flex;align-items:center;gap:7px">
          <i style="width:9px;height:9px;border-radius:3px;background:#AF47B2;display:block"></i>
          <span style="font-size:12px;font-weight:500;color:#64748b">Capture price</span>
        </div>
      </div>
      <div style="margin-top:10px">${priceCurve()}</div>
    </div>
  </div>

  <!-- parent chrome: the post-save contract, in the user's language -->
  <div style="display:flex;align-items:center;gap:16px;padding:14px 20px;border-top:1px solid var(--hair);
       background:linear-gradient(158deg,rgba(255,255,255,.5),rgba(255,255,255,.3))">
    <span class="t-meta" style="flex:1;min-width:0;display:flex;align-items:center;gap:7px">
      ${ic("link", 14, 1.7)}Saving updates Revenue and the financial model for Valencia BESS.
    </span>
    <button class="btn btn-secondary">Cancel</button>
    <button class="btn btn-primary">${ic("check", 16, 1.9)}Save changes</button>
  </div>
</div>`;

const inputTile = ({ label, value, source, action }) => `
<div class="l3" style="padding:13px 15px;flex:1;min-width:0;display:flex;align-items:center;gap:12px">
  <span style="flex:1;min-width:0">
    <span class="kpi-lab" style="display:block">${label}</span>
    <span style="display:block;font-size:14px;font-weight:500;color:var(--s900);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${value}</span>
    <span style="display:block;margin-top:6px">${source}</span>
  </span>
  ${action ? `<button class="btn btn-secondary" style="height:32px;padding:0 12px;flex:none">${action}</button>` : ""}
</div>`;

const embedded = doc({
  w: 1440, h: 1000, side: projectSide("dispatch"), extraCss: REVCSS,
  overlay: curveModal(),
  body: `
${header({
  crumb: `<a href="#">Home</a><span class="sep">${ic("right", 12, 2)}</span><a href="#">Projects</a><span class="sep">${ic("right", 12, 2)}</span><a href="#">Valencia BESS</a><span class="sep">${ic("right", 12, 2)}</span><b>Engineering</b>`,
  eyebrow: `<span style="display:inline-flex;align-items:center;gap:9px">Engineering ${src("storebrid")}</span>`,
  title: "Dispatch",
  meta: "Base case 2027 · hourly · 21 August",
  actions: `<button class="btn btn-secondary">${ic("upRight", 16)}Export</button>
            <button class="btn btn-primary">${ic("activity", 16)}Re-run simulation</button>`,
})}

<div style="display:flex;gap:16px;margin-top:20px">
  ${inputTile({ label: "Simulation", value: "Base case 2027", source: src("storebrid") })}
  ${inputTile({ label: "Price curve", value: "Base case 2026", source: src("revenew"), action: "Edit" })}
  ${inputTile({ label: "Horizon", value: "2027 – 2042", source: src("suite") })}
</div>

<section class="l1 hero" style="padding:20px 22px;margin-top:22px">
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:14px">
    <h2 class="t-sec">Dispatch profile</h2>
    <span class="t-meta">Highest-spread day · 21 August · MW</span>
  </div>
  <div style="margin-bottom:12px">${legend([["Charging", "#5B8DEF"], ["Discharging", "#1D4ED8"]])}</div>
  ${dispatchChart()}
</section>`,
});
writeFileSync("EmbeddedWorkflow.dc.html", embedded);
console.log("EmbeddedWorkflow.dc.html", embedded.length);

/* ═══════════════════════════════════════════════════════════════
   SCREEN 5b — the states the modal has to have
   §32 — loading, error/fallback, saved confirmation + return to context
   ═══════════════════════════════════════════════════════════════ */
const skel = (w, h = 10) =>
  `<span style="display:block;width:${w};height:${h}px;border-radius:${h / 2}px;background:rgba(30,58,138,.09)"></span>`;

const stateCol = ({ n, name, note, panel }) => `
<div style="flex:1;min-width:0;display:flex;flex-direction:column">
  <div style="display:flex;align-items:baseline;gap:9px">
    <span style="font-size:11px;font-weight:700;color:var(--blue700)">${n}</span>
    <span class="t-card" style="font-size:15px">${name}</span>
  </div>
  <p class="t-meta" style="margin:6px 0 14px;line-height:1.5;min-height:31px">${note}</p>
  ${panel}
</div>`;

const modalChrome = (body, foot) => `
<div class="l2" style="overflow:hidden">
  <div style="display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--hair)">
    <div style="flex:1;min-width:0">
      <div class="t-card" style="font-size:14px">Edit forecast curve</div>
      <div style="display:flex;align-items:center;gap:9px;margin-top:3px">
        <span class="t-meta">Valencia BESS</span>${src("revenew")}
      </div>
    </div>
    <span style="color:var(--s400);display:flex;flex:none">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5.4 5.4l9.2 9.2M14.6 5.4l-9.2 9.2"/></svg>
    </span>
  </div>
  ${body}
  ${foot ? `<div style="display:flex;align-items:center;gap:9px;padding:13px 16px;border-top:1px solid var(--hair);
       background:linear-gradient(158deg,rgba(255,255,255,.5),rgba(255,255,255,.3))">${foot}</div>` : ""}
</div>`;

const embedStates = sheet({
  w: 1440, h: 560,
  body: `
<p class="eyebrow" style="color:var(--blue700);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:11px">Screen 5 · States</p>
<h1 class="t-page" style="font-size:24px">When the other product is slow, broken, or done</h1>
<div style="display:flex;gap:24px;margin-top:22px;align-items:flex-start">

  ${stateCol({
    n: "01", name: "Loading",
    note: "The parent owns the frame from the first frame, so the modal never appears empty or jumps size.",
    panel: modalChrome(`
      <div style="padding:18px 16px;display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;gap:14px">
          <div style="width:96px;flex:none;display:flex;flex-direction:column;gap:9px">
            ${skel("60%", 8)}${skel("100%", 30)}${skel("50%", 8)}${skel("100%", 30)}
          </div>
          <div style="flex:1;display:flex;flex-direction:column;gap:9px">
            ${skel("45%", 8)}${skel("100%", 96)}
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:9px;margin-top:2px">
          <span style="width:13px;height:13px;border-radius:50%;border:2px solid rgba(37,99,235,.2);border-top-color:${SB};display:block"></span>
          <span class="t-meta">Loading the forecast editor…</span>
        </div>
      </div>`),
  })}

  ${stateCol({
    n: "02", name: "Didn’t load",
    note: "Never a dead end: retry, or take the same work straight to Revenew. The user is told what is safe, in their own words.",
    panel: modalChrome(`
      <div style="padding:26px 20px 22px;text-align:center">
        <span style="width:40px;height:40px;margin:0 auto;border-radius:12px;display:flex;align-items:center;justify-content:center;
              background:rgba(245,158,11,.13);color:#9A6208">${ic("alert", 20)}</span>
        <div class="t-card" style="font-size:14px;margin-top:13px">The forecast editor didn’t load</div>
        <p class="t-body" style="font-size:12.5px;color:var(--s500);margin-top:7px;line-height:1.55">
          Nothing was changed. You can try again, or open the curve directly in Revenew.
        </p>
      </div>`,
      `<button class="btn btn-ghost" style="height:32px;font-size:12.5px">Cancel</button>
       <span style="flex:1"></span>
       <button class="btn btn-secondary" style="height:32px;font-size:12.5px">Open in Revenew${ic("upRight", 13, 1.8)}</button>
       <button class="btn btn-primary" style="height:32px;font-size:12.5px">Try again</button>`),
  })}

  ${stateCol({
    n: "03", name: "Saved — back in context",
    note: "The modal closes onto the screen it came from. What the save invalidates is stated, and the next action is offered rather than assumed.",
    panel: `
      <div class="l2" style="display:flex;align-items:flex-start;gap:11px;padding:13px 15px">
        <span style="width:22px;height:22px;flex:none;border-radius:7px;display:flex;align-items:center;justify-content:center;
              background:rgba(16,185,129,.14);color:#0E9469">${ic("check", 14, 2.1)}</span>
        <span style="flex:1;min-width:0">
          <span class="t-card" style="display:block;font-size:13.5px">Forecast curve updated</span>
          <span class="t-meta" style="display:block;margin-top:3px;line-height:1.5">Revenue and the financial model will recalculate.</span>
        </span>
      </div>
      <div class="l3" style="padding:13px 15px;margin-top:12px;display:flex;align-items:center;gap:12px">
        <span style="flex:1;min-width:0">
          <span class="kpi-lab" style="display:block">Price curve</span>
          <span style="display:block;font-size:13.5px;font-weight:500;color:var(--s900);margin-top:4px">Base case 2026</span>
          <span style="display:flex;align-items:center;gap:9px;margin-top:6px">${src("revenew")}<span class="t-meta">updated just now</span></span>
        </span>
      </div>
      <div class="l1" style="padding:13px 15px;margin-top:12px;display:flex;align-items:center;gap:12px">
        <span style="color:#9A6208;display:flex;flex:none">${ic("alert", 17)}</span>
        <span style="flex:1;min-width:0">
          <span style="display:block;font-size:13px;font-weight:500;color:var(--s900)">Dispatch results are out of date</span>
          <span class="t-meta" style="display:block;margin-top:3px">Base case 2027 · ran with the previous curve</span>
        </span>
        <button class="btn btn-primary" style="height:32px;font-size:12.5px;flex:none">Re-run</button>
      </div>`,
  })}
</div>`,
});
writeFileSync("EmbeddedStates.dc.html", embedStates);
console.log("EmbeddedStates.dc.html", embedStates.length);

/* ═══════════════════════════════════════════════════════════════
   SCREEN 6 — Cross-product Analytics
   §14 §15 §34 — the scatter is the argument: one axis owned by
   StoreBrid, the other by Revenew, and neither product can draw it.
   Single hue, so no categorical palette to validate.
   ═══════════════════════════════════════════════════════════════ */
const FLEET = [
  /* name, utilisation %, IRR %, MW */
  ["Murcia BESS", 78, 13.4, 110, "start"],
  ["Valencia BESS", 74, 12.8, 100, "top"],
  ["Girona BESS", 76, 12.6, 85, null],
  ["Bilbao BESS", 71, 12.1, 90, null],
  ["Madrid Hybrid", 68, 11.9, 80, null],
  ["Córdoba Storage", 62, 10.6, 45, null],
  ["Faro Storage", 64, 10.1, 35, null],
  ["Évora Hybrid", 59, 9.6, 50, null],
  ["Almería BESS", 81, 9.4, 60, "start"],
  ["Toledo Hybrid", 57, 8.9, 70, null],
  ["Cádiz Storage", 52, 7.8, 40, "start"],
];

function fleetScatter() {
  const W = 660, H = 344, L = 46, R = 16, T = 16, B = 40;
  const pw = W - L - R, ph = H - T - B;
  const xlo = 45, xhi = 90, ylo = 6, yhi = 15;
  const x = (v) => L + ((v - xlo) / (xhi - xlo)) * pw;
  const y = (v) => T + ph - ((v - ylo) / (yhi - ylo)) * ph;
  const r = (mw) => 6 + ((mw - 35) / 75) * 7;

  const gx = [50, 60, 70, 80, 90].map((g) =>
    `<line x1="${x(g).toFixed(1)}" y1="${T}" x2="${x(g).toFixed(1)}" y2="${T + ph}" stroke="${GRID}" stroke-width="1"/>
     <text x="${x(g).toFixed(1)}" y="${T + ph + 15}" text-anchor="middle" font-size="9.5" fill="${AXIS}">${g}%</text>`).join("");
  const gy = [6, 9, 12, 15].map((g) =>
    `<line x1="${L}" y1="${y(g).toFixed(1)}" x2="${W - R}" y2="${y(g).toFixed(1)}" stroke="${GRID}" stroke-width="1"/>
     <text x="${L - 8}" y="${(y(g) + 3.4).toFixed(1)}" text-anchor="end" font-size="9.5" fill="${AXIS}">${g}%</text>`).join("");

  const dots = FLEET.map(([n, u, irr, mw]) =>
    `<circle class="mk" cx="${x(u).toFixed(1)}" cy="${y(irr).toFixed(1)}" r="${r(mw).toFixed(1)}"
       fill="#0891B2" fill-opacity=".72" stroke="#fff" stroke-width="2"><title>${n} — ${u}% utilisation · ${irr}% IRR · ${mw} MW</title></circle>`).join("");

  /* selective direct labels: the two extremes and the one outlier */
  const labs = FLEET.filter((f) => f[4]).map(([n, u, irr, mw, pos]) =>
    pos === "top"
      ? `<text x="${(x(u) - 6).toFixed(1)}" y="${(y(irr) - r(mw) - 9).toFixed(1)}" text-anchor="middle" font-size="10.5" font-weight="600" fill="#0F172A">${n}</text>`
      : `<text x="${(x(u) + r(mw) + 7).toFixed(1)}" y="${(y(irr) + 3.6).toFixed(1)}" text-anchor="start" font-size="10.5" font-weight="600" fill="#0F172A">${n}</text>`).join("");

  return `
<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block" role="img" aria-label="Battery utilisation against IRR, one dot per connected project, sized by installed power">
  <style>.mk{transition:opacity .12s} .mk:hover{opacity:.85}</style>
  ${gx}${gy}${dots}${labs}
  <text x="${L - 8}" y="${T + 4}" text-anchor="end" font-size="9" fill="${AXIS}">IRR</text>
</svg>`;
}

const reviewRow = ({ name, reading, prompt, last }) => `
<div style="padding:13px 16px;${last ? "" : "border-bottom:1px solid var(--hair)"}">
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px">
    <a href="#" style="font-size:13.5px;font-weight:500">${name}</a>
    <span class="t-meta" style="white-space:nowrap">${reading}</span>
  </div>
  <div class="t-meta" style="margin-top:5px;line-height:1.5">${prompt}</div>
</div>`;

/* every €/MWh in the table is derived, never typed */
const CMP = [
  { name: "Murcia BESS",     mwh: 220, cycles: 348, util: 78, degr: 2.3, rev: 9.80, irr: 13.4 },
  { name: "Valencia BESS",   mwh: 200, cycles: 326, util: 74, degr: 2.1, rev: 8.42, irr: 12.8 },
  { name: "Girona BESS",     mwh: 170, cycles: 331, util: 76, degr: 2.2, rev: 7.10, irr: 12.6 },
  { name: "Madrid Hybrid",   mwh: 120, cycles: 298, util: 68, degr: 1.9, rev: 4.55, irr: 11.9 },
  { name: "Almería BESS",    mwh: 120, cycles: 356, util: 81, degr: 2.6, rev: 4.34, irr: 9.4 },
  { name: "Sevilla Storage", mwh: 100, cycles: 312, util: 71, degr: 2.0, linked: false },
];
const eur = (n) => "€" + n.toFixed(1);
const cmpRow = (p) => {
  const num = (t) => `<td class="t-tbl" style="text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums">${t}</td>`;
  const gap = `<td style="text-align:right"><span class="t-meta" style="opacity:.55">—</span></td>`;
  return `
<tr>
  <td><a href="#" class="anchor">${p.name}</a>
      ${p.linked === false ? `<div class="t-meta" style="margin-top:2px">Not linked to Revenew · <a href="#" style="font-size:11px">Link</a></div>` : ""}</td>
  ${num(p.cycles)}${num(p.util + "%")}${num(p.degr.toFixed(1) + "%/yr")}
  ${p.linked === false ? gap + gap + gap : num(eur(p.rev) + "M") + num(p.irr.toFixed(1) + "%") +
    `<td style="text-align:right;white-space:nowrap"><b style="font-size:13.5px;font-weight:600;color:var(--s900);font-variant-numeric:tabular-nums">${eur(p.rev * 1e6 / (p.cycles * p.mwh))}</b></td>`}
</tr>`;
};
const cmpHead = (label, source, first) => `
<th style="${first ? "" : "text-align:right"};vertical-align:bottom;height:54px;padding-bottom:9px">
  <span style="display:block">${label}</span>
  <span style="display:${first ? "block" : "flex"};justify-content:flex-end;margin-top:5px;font-weight:400">${source}</span>
</th>`;

const analytics = doc({
  w: 1440, h: 1360, side: rootSide("analytics"),
  body: `
${header({
  crumb: `<a href="#">Home</a><span class="sep">${ic("right", 12, 2)}</span><b>Analytics</b>`,
  eyebrow: "11 projects connected to both products · 1.24 GW · 2.48 GWh",
  title: "Analytics",
  actions: `<button class="btn btn-secondary">${ic("upRight", 16)}Export</button>`,
})}

<div style="display:flex;align-items:center;gap:12px;margin:20px 0 22px;flex-wrap:wrap">
  <button class="btn btn-secondary">${ic("layers", 16)}Iberia Core${ic("down", 15, 1.8)}</button>
  <button class="btn btn-secondary">${ic("clock", 16)}2026${ic("down", 15, 1.8)}</button>
  <div class="tabs">
    <a href="#" class="on">Connected only <span class="count">11</span></a>
    <a href="#">All projects <span class="count">24</span></a>
  </div>
  <span style="margin-left:auto;display:flex;align-items:center;gap:7px" class="t-meta">
    ${ic("link", 14, 1.7)}Combined metrics need both products linked
  </span>
</div>

<div class="grid" style="grid-template-columns:repeat(5, minmax(0, 1fr))">
  ${kpi({ label: "Battery utilisation", value: "72%", source: src("storebrid"), delta: "+3 pt" })}
  ${kpi({ label: "Energy discharged", value: "512 GWh", source: src("storebrid"), delta: "+6.2%" })}
  ${kpi({ label: "Annual revenue", value: "€63.4M", source: src("revenew"), delta: "+4.1%" })}
  ${kpi({ label: "Portfolio IRR", value: "11.4%", source: src("revenew"), delta: "−0.2 pt" })}
  ${kpi({ label: "Revenue / MWh discharged", value: "€123.8", source: src("combined"),
          combined: true, formula: "€63.4M revenue ÷ 512 GWh discharged" })}
</div>

<div style="display:flex;gap:20px;margin-top:24px;align-items:stretch">
  <section class="l1 hero" style="flex:1.62;min-width:0;padding:20px 22px">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
      <div>
        <h2 class="t-sec">Technical utilisation vs financial return</h2>
        <p class="t-meta" style="margin-top:5px">11 connected projects · 2026 · dot size is installed power</p>
      </div>
      ${src("combined")}
    </div>
    <div style="margin-top:14px">${fleetScatter()}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:4px;padding-top:12px;border-top:1px solid var(--hair)">
      <span style="display:inline-flex;align-items:center;gap:7px"><span class="t-meta">Battery utilisation</span>${src("storebrid")}</span>
      <span style="display:inline-flex;align-items:center;gap:7px"><span class="t-meta">IRR</span>${src("revenew")}</span>
    </div>
  </section>

  <section class="l1" style="flex:1;min-width:0;overflow:hidden;display:flex;flex-direction:column">
    <div style="padding:15px 16px 13px;background:linear-gradient(158deg,rgba(255,255,255,.44),rgba(255,255,255,.26))">
      <div class="t-card" style="font-size:15px">Worth a look</div>
      <div class="t-meta" style="margin-top:4px">Projects where the technical and the financial picture disagree</div>
    </div>
    ${reviewRow({ name: "Almería BESS", reading: "81% · 9.4% IRR", prompt: "Cycles hardest in the portfolio, returns second from bottom. Review the degradation and ReCapEx assumptions." })}
    ${reviewRow({ name: "Cádiz Storage", reading: "52% · 7.8% IRR", prompt: "Lowest utilisation. Check whether the export limit in the plant configuration still matches the grid offer." })}
    ${reviewRow({ name: "Toledo Hybrid", reading: "57% · 8.9% IRR", prompt: "Dispatch and revenue both below the co-located median. Compare against Madrid Hybrid.", last: true })}
    <div style="flex:1"></div>
  </section>
</div>

<div style="display:flex;align-items:baseline;justify-content:space-between;margin:26px 0 14px">
  <h2 class="t-sec">Project comparison</h2>
  <a href="#" style="font-size:13px;font-weight:500">Add a column</a>
</div>
<section class="l1" style="overflow:hidden">
  <table class="tbl">
    <thead><tr>
      ${cmpHead("Project", src("suite"), true)}
      ${cmpHead("Cycles / yr", src("storebrid"))}
      ${cmpHead("Utilisation", src("storebrid"))}
      ${cmpHead("Degradation", src("storebrid"))}
      ${cmpHead("Annual revenue", src("revenew"))}
      ${cmpHead("IRR", src("revenew"))}
      ${cmpHead("Revenue / MWh", src("combined"))}
    </tr></thead>
    <tbody>${CMP.map(cmpRow).join("")}</tbody>
  </table>
</section>
<p class="t-meta" style="margin-top:12px">
  Sevilla Storage has no financial figures because it is not linked to Revenew — the columns stay in place and stay empty, rather than the project dropping out of the comparison.
</p>`,
});
writeFileSync("Analytics.dc.html", analytics);
console.log("Analytics.dc.html", analytics.length);

/* ── canvas manifest ─────────────────────────────────────────────
   Laid out in the §37 prototyping order, left to right, top to
   bottom. Row positions are computed so a note never lands on an
   artboard.                                                       */
const COLX = [0, 1560, 3120];
const ROWS = [
  [["Main.dc.html", 1440, 1040, "1 · Suite Home (dual-licence)"],
   ["Projects.dc.html", 1440, 940, "2 · Unified Projects"],
   ["ProjectOverview.dc.html", 1440, 1280, "3 · Unified Project Overview"]],
  [["Workspace.dc.html", 1440, 1000, "4 · Project workspace navigation"],
   ["EmbeddedWorkflow.dc.html", 1440, 1000, "5 · Embedded cross-product workflow"],
   ["Analytics.dc.html", 1440, 1360, "6 · Cross-product Analytics"]],
  [["EmbeddedStates.dc.html", 1440, 560, "5b · Embedded workflow states"],
   ["SourceAttribution.dc.html", 800, 860, "Pattern · Source attribution"]],
];

const NOTES = {
  "Main.dc.html": ["n-home",
    "SCREEN 1 · Suite Home — dual-licence\n\nGoal: prove the Suite is one workspace, not a launcher. The portfolio bar is the whole argument — 24 projects, 11 of them connected to both products.\n\nSources: Suite (capacity, counts) · StoreBrid + Revenew (activity) · Combined (revenue / MWh).\n\nOn click: project cards and activity rows go to the Suite Project Overview, never straight into a product."],
  "Projects.dc.html": ["n-projects",
    "SCREEN 2 · Unified Projects\n\nGoal: establish the Suite Project. Product coverage is a COLUMN — a property of the project — not two launch buttons.\n\nNote §7: coverage ≠ entitlement. Victor holds both licences, but Sevilla Storage is StoreBrid-only and Porto PV is Revenew-only.\n\nOn click: a row opens the Project Overview."],
  "ProjectOverview.dc.html": ["n-overview",
    "SCREEN 3 · Unified Project Overview — the showcase\n\nGoal: both products in one project experience. The Performance panel holds two recessed wells rather than two competing cards — one surface, two sources.\n\nThe 5th KPI is the Combined one (§15): it belongs to neither product and shows its own derivation, because a metric nobody owns has to earn trust.\n\nSidebar moved to Engineering / Commercial (§11). Product names dropped to a dot beside the group label."],
  "Workspace.dc.html": ["n-workspace",
    "SCREEN 4 · Project workspace navigation\n\nGoal: kill the application-switching mental model. The page is titled “Simulations” under “Engineering” — StoreBrid appears only as an attribution dot, and the project name never leaves the sidebar or the breadcrumb (§39.3).\n\nThe table is StoreBrid's real simulation vocabulary: Completed, In progress, Running…, Waiting, Completed (error).\n\nTHE THING TO VALIDATE: the “Continue in Commercial” card at the bottom. It is the anti-switching move — a capability-shaped link, not an app link. It is also the piece least supported by the .md, so push on it."],
  "EmbeddedWorkflow.dc.html": ["n-embed",
    "SCREEN 5 · Embedded cross-product workflow\n\nYou are in Engineering (StoreBrid), editing a curve Revenew owns. §25: the parent owns modal, focus, close, fallback and post-save refresh; the product owns its content.\n\nThat split is drawn literally — Suite glass in the header and footer, Revenew's own white/slate/DM-Sans surface in the body. It shows the integration model without ever saying iframe (§39.1).\n\nThe footer states what the save invalidates, in the user's words. “Open in Revenew” is the standing fallback (§26)."],
  "Analytics.dc.html": ["n-analytics",
    "SCREEN 6 · Cross-product Analytics\n\nThe scatter is the argument for the whole Suite: X is owned by StoreBrid, Y by Revenew, and neither product can draw this chart alone (§15).\n\nAlmería BESS is the payload — hardest-cycled, second-worst return. That contradiction is invisible inside either product.\n\nFAILURE STATE (§38): Sevilla Storage is StoreBrid-only, so its financial columns stay in place and stay empty with a Link affordance, rather than the project dropping out of the comparison."],
  "EmbeddedStates.dc.html": ["n-states",
    "SCREEN 5b · The states screen 5 has to have (§32)\n\nLoading, didn't-load, and saved-back-in-context. The error state is the one that matters: never a dead end, always “nothing was changed” plus a route to Revenew.\n\nThe third panel is the return-to-context flow — the save invalidates the dispatch run, so the next action is offered instead of assumed."],
  "SourceAttribution.dc.html": ["n-attrib",
    "PATTERN SHEET — supporting, not one of the six screens.\n\nThe attribution chip and the two badge families, pulled out so they can be argued about once instead of on every screen.\n\nDelete this artboard if you would rather keep the canvas to the screens alone."],
};

const artboards = [], annotations = [];
let rowY = 0;
for (const row of ROWS) {
  row.forEach(([file, w, h, title], i) => {
    artboards.push({ file, x: COLX[i], y: rowY, w, h, title, print: "fixed" });
    const [id, text] = NOTES[file];
    annotations.push({ id, x: COLX[i], y: rowY - 230, w: 460, text });
  });
  rowY += Math.max(...row.map((r) => r[2])) + 300;
}
writeFileSync("canvas.json", JSON.stringify({ artboards, annotations, launch: { view: "canvas" } }, null, 2));
console.log("canvas.json —", artboards.length, "artboards,", annotations.length, "notes");
