</div>

<div style="display:flex;gap:20px;margin-top:28px;align-items:flex-start">
  <section style="flex:1.55;min-width:0">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px">
      <h2 class="t-sec">Recent activity</h2>
      <a href="#" style="font-size:13px;font-weight:500">View all</a>
    </div>
    <div class="l1" style="overflow:hidden">
      ${activityRow({ what: "Simulation #24 completed", project: "Valencia BESS", source: src("storebrid"), when: "2h ago" })}
      ${activityRow({ what: 'Forecast scenario "High spread 2027" updated', project: "Valencia BESS", source: src("revenew"), when: "4h ago" })}
      ${activityRow({ what: "Financial model recalculated", project: "Madrid Hybrid", source: src("revenew"), when: "Yesterday" })}
      ${activityRow({ what: "PPA contract changed", project: "Valencia BESS", source: src("revenew"), when: "Yesterday" })}
      ${activityRow({ what: "Plant configuration changed", project: "Sevilla Storage", source: src("storebrid"), when: "2d ago" })}
      ${activityRow({ what: "Simulation #23 completed (error)", project: "Madrid Hybrid", source: src("storebrid"), when: "2d ago", last: true })}
    </div>
  </section>

  <section style="flex:1;min-width:0">
    <div style="margin-bottom:14px"><h2 class="t-sec">Portfolio performance</h2></div>
    <div class="l1" style="padding:8px">
      ${perfRow({ label: "Portfolio IRR", value: "11.4%", source: src("revenew") })}
      ${perfRow({ label: "Annual revenue · 2026", value: "€63.4M", source: src("revenew") })}
      ${perfRow({ label: "Energy discharged · 2026", value: "512 GWh", source: src("storebrid") })}
      <div style="height:1px;background:var(--hair);margin:6px 16px 10px"></div>
      ${perfRow({ label: "Revenue / MWh discharged", value: "€123.8", source: src("combined"), tinted: true,
                  formula: "€63.4M revenue ÷ 512 GWh discharged" })}
    </div>
  </section>
</div>`,
});
writeFileSync("Main.dc.html", home);
console.log("Main.dc.html", home.length);

/* ═══════════════════════════════════════════════════════════════
   SCREEN 2 — Unified Projects
   §8 — a neutral project list; coverage is a column, not a launcher
   ═══════════════════════════════════════════════════════════════ */
const techPill = (label, color) =>
