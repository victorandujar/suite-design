  <div style="position:relative;z-index:1;padding:30px 32px 36px">${body}</div>
</div>
</x-dc>
<script data-dc-script data-props='{"$preview":{"width":${w},"height":${h}}}'>
class Component extends DCLogic {}
</script>
</body>
</html>
`;

const srcSpec = ({ chip, when, click }) => `
<div style="display:flex;align-items:flex-start;gap:16px;padding:14px 16px;border-bottom:1px solid var(--hair)">
  <span style="width:104px;flex:none;padding-top:1px">${chip}</span>
  <span style="flex:1;min-width:0">
    <span style="display:block;font-size:13px;color:var(--s700);line-height:1.5">${when}</span>
    <span style="display:block;font-size:11px;color:var(--s400);margin-top:4px">On click → ${click}</span>
  </span>
</div>`;

const swatch = (name, hex, role) => `
<div class="l3" style="padding:12px 14px;flex:1;min-width:0">
  <span style="display:block;width:100%;height:34px;border-radius:8px;background:${hex};
        box-shadow:inset 0 1px 0 rgba(255,255,255,.28)"></span>
  <div style="font-size:13px;font-weight:600;color:var(--s900);margin-top:10px">${name}</div>
  <div class="t-meta" style="margin-top:3px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">${hex}</div>
  <div class="t-meta" style="margin-top:5px">${role}</div>
</div>`;

const attribution = sheet({
  w: 800, h: 860,
  body: `
<p class="eyebrow" style="color:var(--blue700);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:11px">Suite · Pattern</p>
<h1 class="t-page" style="font-size:26px">Source attribution</h1>
<p class="t-body" style="color:var(--s500);margin-top:8px;max-width:56ch">
  Every KPI, chart and activity line carries the product that owns the calculation.
  Present, never dominant: 11&nbsp;px, slate&nbsp;400, a 5&nbsp;px dot — it reads as metadata, not as a badge.
</p>

<section class="l1 hero" style="margin-top:22px;overflow:hidden">
  <div style="padding:14px 16px 12px;background:linear-gradient(158deg,rgba(255,255,255,.44),rgba(255,255,255,.26))">
    <span class="t-lab" style="font-weight:600;color:var(--s500)">The four sources</span>
  </div>
  ${srcSpec({ chip: src("suite"), when: "Neutral metadata the Suite owns — name, country, technology, capacity, status.", click: "stays in the Suite" })}
  ${srcSpec({ chip: src("storebrid"), when: "Technical and engineering results — simulations, dispatch, cycles, throughput.", click: "deep-links into the StoreBrid workflow" })}
  ${srcSpec({ chip: src("revenew"), when: "Commercial and financial results — forecasts, revenue, costs, IRR, NPV.", click: "deep-links into the Revenew workflow" })}
  <div style="border-bottom:none">${srcSpec({ chip: src("combined"), when: "Only exists because the Suite understands both domains. Always shows how it is derived.", click: "opens the combined metric in Analytics" })}</div>
</section>

<h2 class="t-sec" style="font-size:16px;margin-top:24px">Product accents</h2>
<p class="t-meta" style="margin-top:5px">Lifted from each product. The Suite is the parent brand; it does not flatten them.</p>
<div style="display:flex;gap:14px;margin-top:12px">
  ${swatch("StoreBrid", SB, "Engineering · technical")}
  ${swatch("Revenew", RN, "Commercial · financial")}
  ${swatch("Suite", SU, "Neutral · combined")}
</div>

<h2 class="t-sec" style="font-size:16px;margin-top:24px">Two badge families — never mixed</h2>
<div style="display:flex;gap:14px;margin-top:12px">
  <div class="l1" style="padding:16px;flex:1;min-width:0">
    <div class="t-lab" style="font-weight:600;color:var(--s700)">Product coverage</div>
    <div style="margin-top:11px">${cov(1, 0)}</div>
    <p class="t-meta" style="margin-top:11px;line-height:1.5">
      Which products are linked to this <b style="font-weight:600;color:var(--s500)">project</b>.
      A dimmed pill means not linked — never a disabled control.
    </p>
  </div>
  <div class="l1" style="padding:16px;flex:1;min-width:0">
    <div class="t-lab" style="font-weight:600;color:var(--s700)">Status</div>
    <div style="margin-top:11px;display:flex;gap:7px;flex-wrap:wrap">${ST.active}${ST.development}${ST.draft}</div>
    <p class="t-meta" style="margin-top:11px;line-height:1.5">
      What <b style="font-weight:600;color:var(--s500)">state</b> the thing is in. Rounder tint, always with a dot,
      so state never rests on hue alone.
    </p>
  </div>
</div>`,
});
writeFileSync("SourceAttribution.dc.html", attribution);
console.log("SourceAttribution.dc.html", attribution.length);



