// Sunveon Suite — design canvas artboards.
// Builds the .dc.html artboards from one shared foundation so the design system
// stays identical across screens (artboards share nothing at runtime).
import { writeFileSync } from "node:fs";

/* ─────────────────────────────────────────────────────────────
   FOUNDATION — Premium Light Spatial Glass
   Values lifted from the StoreBrid design-system sheets.
   ───────────────────────────────────────────────────────────── */
const CSS = `
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root{
  /* 01 · Color — brand blue untouched, ink recalibrated */
  --blue600:#2563EB; --blue700:#1D4ED8; --blue500:#3B82F6; --cyan:#06B6D4;
  --emerald:#10B981; --amber:#F59E0B; --violet:#8B5CF6; --red:#DC2626;
  --revenew:#AF47B2;
  --s900:#0F172A; --s700:#334155; --s500:#54617A; --s400:#5F6C82;
  --hair:rgba(30,58,138,.07);
  /* 05 · Cold shadows, never grey — high radius, minimal displacement */
  --sh-xs:0 1px 2px rgba(30,58,138,.05);
  --sh-sm:0 2px 10px -4px rgba(30,58,138,.09);
  --sh-md:0 10px 30px -14px rgba(30,58,138,.14), 0 2px 6px -3px rgba(30,58,138,.06);
  --sh-lg:0 24px 64px -26px rgba(30,58,138,.22), 0 6px 16px -9px rgba(30,58,138,.10);
}

*,*::before,*::after{box-sizing:border-box}
body{
  margin:0; font-family:Inter,'Helvetica Neue',Arial,sans-serif; color:var(--s700);
  font-size:14px; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
}
a{color:var(--blue700); text-decoration:none}
a:hover{color:var(--blue600)}

/* 03 · Atmósfera — the background you never look at */
.atmos{
  min-height:100%;
  background:
    radial-gradient(1700px 1180px at 6% -14%, rgba(120,165,225,.20), transparent 62%),
    radial-gradient(1900px 1300px at 94% -8%,  rgba(125,180,205,.15), transparent 62%),
    radial-gradient(1200px 900px  at 96% 108%, rgba(135,170,215,.09), transparent 60%),
    radial-gradient(1100px 820px  at 4%  102%, rgba(130,180,210,.08), transparent 60%),
    linear-gradient(158deg,#E4EBF7 0%,#EFF3FA 46%,#E6EDF8 100%);
}
/* one local focus per screen, inside the content area, behind the main object */
.focus{
  position:absolute; left:6%; top:4%; width:74%; height:64%; pointer-events:none; z-index:0;
  background:
    radial-gradient(closest-side, rgba(59,130,246,.13), transparent 74%),
    radial-gradient(closest-side at 76% 70%, rgba(6,182,212,.07), transparent 72%);
}

/* 04 · Superficies de cristal */
.l1{
  background:linear-gradient(158deg,rgba(255,255,255,.62),rgba(255,255,255,.48) 52%,rgba(255,255,255,.40));
  backdrop-filter:blur(16px) saturate(190%); -webkit-backdrop-filter:blur(16px) saturate(190%);
  border:1px solid rgba(37,99,235,.09); border-radius:16px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.62), var(--sh-md);
}
/* superficie protagonista — one per screen: --sh-lg, blue edge at 17%, own halo */
.l1.hero{
  border-color:rgba(37,99,235,.17);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.72), var(--sh-lg);
}
.l2{
  background:linear-gradient(158deg,rgba(255,255,255,.86),rgba(255,255,255,.68));
  backdrop-filter:blur(18px) saturate(190%); -webkit-backdrop-filter:blur(18px) saturate(190%);
  border:1px solid rgba(37,99,235,.09); border-radius:12px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.8), var(--sh-md);
}
/* a content group inside a card is not another card — it is a recess of the panel */
.l3{
  background:linear-gradient(158deg,rgba(255,255,255,.44),rgba(255,255,255,.26));
  border:1px solid rgba(37,99,235,.07); border-radius:12px;
}

/* 02 · Tipografía — Inter, seven roles */
.t-page{font-size:30px;font-weight:700;line-height:1.14;letter-spacing:-.025em;color:var(--s900);margin:0}
.t-sec {font-size:20px;font-weight:700;line-height:1.25;letter-spacing:-.015em;color:var(--s900);margin:0}
.t-card{font-size:16px;font-weight:600;line-height:1.35;color:var(--s900);margin:0}
.t-body{font-size:14px;font-weight:400;line-height:1.55;color:var(--s700);margin:0}
.t-tbl {font-size:13px;font-weight:400;line-height:1.4;color:var(--s700)}
.t-lab {font-size:12px;font-weight:500;line-height:1.3;color:var(--s500)}
.t-meta{font-size:11px;font-weight:400;line-height:1.4;color:var(--s400)}
.eyebrow{font-size:12px;font-weight:500;line-height:1.3;color:var(--s500);margin:0 0 6px}

/* Shell */
.shell{display:flex;align-items:stretch;min-height:100%}
.side{
  width:232px;flex:none;position:relative;z-index:2;display:flex;flex-direction:column;
  padding:18px 12px 14px;
  background:linear-gradient(180deg,rgba(255,255,255,.58),rgba(255,255,255,.40));
  backdrop-filter:blur(16px) saturate(190%); -webkit-backdrop-filter:blur(16px) saturate(190%);
  border-right:1px solid rgba(37,99,235,.09);
}
.main{position:relative;flex:1;min-width:0;overflow:hidden}
.content{position:relative;z-index:1;padding:26px 32px 36px}

.brand{display:flex;align-items:center;gap:9px;padding:2px 8px 0}
.brand-name{font-size:14px;font-weight:700;letter-spacing:-.015em;color:var(--s900);line-height:1.1}
.brand-sub{font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase;color:var(--s400);line-height:1.1;margin-top:3px}

.nav{display:flex;flex-direction:column;gap:2px}
.nav a{display:flex;align-items:center;gap:10px;height:34px;padding:0 10px;border-radius:9px;
  font-size:13px;font-weight:500;color:var(--s500);transition:background .15s,color .15s}
.nav a svg{flex:none;opacity:.85}
.nav a:hover{background:rgba(255,255,255,.55);color:var(--s900)}
/* the active item is marked by elevation, never by a grey fill */
.nav a.on{
  background:linear-gradient(158deg,rgba(255,255,255,.9),rgba(255,255,255,.7));
  color:var(--blue700);font-weight:600;
  box-shadow:var(--sh-sm), inset 0 1px 0 rgba(255,255,255,.85);
}
.nav a.on svg{opacity:1}
.grp{display:flex;align-items:center;justify-content:flex-start;gap:7px;
  padding:0 10px;margin:18px 0 7px;
  font-size:10px;font-weight:600;letter-spacing:.085em;text-transform:uppercase;color:var(--s400)}
.rule{height:1px;background:var(--hair);margin:12px 6px}

/* Buttons — radius 10, height 38, one focus ring for the whole system */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 15px;
  border-radius:10px;border:1px solid transparent;font-size:13px;font-weight:500;cursor:pointer;
  white-space:nowrap;transition:box-shadow .15s,background .15s}
.btn-primary{background:var(--blue600);color:#fff;
  box-shadow:0 8px 18px -10px rgba(37,99,235,.65), inset 0 1px 0 rgba(255,255,255,.24)}
.btn-primary:hover{background:#1E56D6}
.btn-secondary{color:var(--s900);border-color:rgba(37,99,235,.13);
  background:linear-gradient(158deg,rgba(255,255,255,.88),rgba(255,255,255,.7));
  box-shadow:var(--sh-xs), inset 0 1px 0 rgba(255,255,255,.8)}
.btn-secondary:hover{box-shadow:var(--sh-sm), inset 0 1px 0 rgba(255,255,255,.85)}
.btn-ghost{color:var(--s500);background:transparent}
.btn-ghost:hover{background:rgba(255,255,255,.55);color:var(--s900)}
.btn-icon{width:38px;padding:0}

/* 10 · Source attribution — present, subtle, never dominant */
.src{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:500;color:var(--s400);white-space:nowrap}
.src i{width:5px;height:5px;border-radius:50%;display:block;flex:none}
.src .pair{display:inline-flex;width:12px;height:5px;position:relative;flex:none}
.src .pair i{position:absolute;top:0}
.src .pair i:first-child{left:0}
.src .pair i:last-child{left:5px;box-shadow:0 0 0 1.5px rgba(255,255,255,.75)}

/* product coverage pill */
.cov{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 9px;border-radius:7px;
  font-size:11px;font-weight:500;color:var(--s500);
  background:rgba(255,255,255,.5);border:1px solid rgba(37,99,235,.08)}
.cov i{width:5px;height:5px;border-radius:50%;display:block;flex:none}
.cov.off{opacity:.34}

/* status badge — colour dot so state never rests on hue alone */
.badge{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px;border-radius:7px;
  font-size:11px;font-weight:500;white-space:nowrap}
.badge i{width:5px;height:5px;border-radius:50%;display:block;flex:none}

/* Table — 48px rows, soft dividers, hover white/40 */
.tbl{width:100%;border-collapse:collapse}
.tbl thead th{height:40px;padding:0 16px;text-align:left;
  font-size:12px;font-weight:600;color:var(--s500);letter-spacing:.005em;white-space:nowrap}
.tbl thead tr{background:linear-gradient(158deg,rgba(255,255,255,.44),rgba(255,255,255,.26))}
.tbl tbody td{height:48px;padding:0 16px;border-top:1px solid var(--hair);font-size:13px;color:var(--s700);vertical-align:middle}
.tbl tbody tr:hover{background:rgba(255,255,255,.4)}
.tbl .anchor{font-size:14px;font-weight:500;color:var(--s900)}
.tbl tbody tr:hover .anchor{color:var(--blue700)}

/* Search — a pill, one field */
.search{display:flex;align-items:center;gap:9px;height:40px;padding:0 14px;border-radius:20px;
  background:linear-gradient(158deg,rgba(255,255,255,.5),rgba(255,255,255,.3));
  border:1px solid rgba(37,99,235,.08);color:var(--s400);font-size:13px}

/* Tabs — active marked by elevation, not grey */
.tabs{display:inline-flex;align-items:center;gap:3px;padding:3px;border-radius:11px;
  background:linear-gradient(158deg,rgba(255,255,255,.4),rgba(255,255,255,.24));
  border:1px solid rgba(37,99,235,.07)}
.tabs a{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 13px;border-radius:8px;
  font-size:13px;font-weight:500;color:var(--s500)}
.tabs a.on{color:var(--s900);font-weight:600;
  background:linear-gradient(158deg,rgba(255,255,255,.92),rgba(255,255,255,.74));
  box-shadow:var(--sh-sm), inset 0 1px 0 rgba(255,255,255,.85)}
.tabs .count{font-size:11px;font-weight:500;color:var(--s400)}
.tabs a.on .count{color:var(--blue700)}

/* KPI */
.kpi{padding:16px 18px 14px;border-radius:12px;display:flex;flex-direction:column;gap:2px;min-width:0}
.kpi-lab{font-size:12px;font-weight:500;color:var(--s500);letter-spacing:.005em}
.kpi-val{font-size:28px;font-weight:700;letter-spacing:-.025em;color:var(--s900);line-height:1.15;margin-top:5px}
.kpi-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:9px}
.delta{font-size:11px;font-weight:500}
.delta.up{color:#0E9469}.delta.down{color:var(--red)}

.grid{display:grid;gap:20px}
.row{display:flex;align-items:center}
.crumb{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:var(--s400);margin-bottom:12px}
.crumb .sep{opacity:.5}
.crumb b{font-weight:500;color:var(--s700)}
`;

/* ─────────────────────────────────────────────────────────────
   ICONS — stroke-based, 16/18/20 grid, one style, currentColor
   ───────────────────────────────────────────────────────────── */
const P = {
  home:     '<path d="M3 9.2 10 3.5l7 5.7"/><path d="M4.6 8.3V16a.9.9 0 0 0 .9.9h9a.9.9 0 0 0 .9-.9V8.3"/>',
  projects: '<rect x="2.8" y="4.4" width="6.1" height="5.2" rx="1.2"/><rect x="11.1" y="4.4" width="6.1" height="5.2" rx="1.2"/><rect x="2.8" y="11.4" width="6.1" height="4.2" rx="1.2"/><rect x="11.1" y="11.4" width="6.1" height="4.2" rx="1.2"/>',
  analytics:'<path d="M3 16.6h14"/><path d="M5.4 13.4V9.1"/><path d="M9.2 13.4V4.9"/><path d="M13 13.4v-5.6"/><path d="M16.6 13.4v-2.6"/>',
  admin:    '<circle cx="10" cy="10" r="2.5"/><path d="M10 2.9v2M10 15.1v2M15 5l-1.4 1.4M6.4 13.6 5 15m10 0-1.4-1.4M6.4 6.4 5 5m12.1 5h-2M4.9 10h-2"/>',
  zap:      '<path d="M11.1 2.7 4.4 11.2h4.3l-.8 6.1 6.7-8.5h-4.3z"/>',
  trend:    '<path d="M2.9 13.9 7.6 9.1l3 3 6.5-6.6"/><path d="M12.9 5.5h4.2v4.2"/>',
  plus:     '<path d="M10 4.6v10.8M4.6 10h10.8"/>',
  search:   '<circle cx="9.1" cy="9.1" r="5.3"/><path d="m13.1 13.1 3.2 3.2"/>',
  upRight:  '<path d="M6.2 13.8 13.8 6.2"/><path d="M7.4 6.2h6.4v6.4"/>',
  right:    '<path d="m7.8 4.6 5.2 5.4-5.2 5.4"/>',
  left:     '<path d="m12.2 4.6-5.2 5.4 5.2 5.4"/>',
  down:     '<path d="m5.2 8 4.8 4.6L14.8 8"/>',
  dots:     '<circle cx="10" cy="4.6" r="1.15" fill="currentColor" stroke="none"/><circle cx="10" cy="10" r="1.15" fill="currentColor" stroke="none"/><circle cx="10" cy="15.4" r="1.15" fill="currentColor" stroke="none"/>',
  alert:    '<path d="M10 3.6 2.9 16.1h14.2z"/><path d="M10 8.2v3.3"/><circle cx="10" cy="13.7" r=".85" fill="currentColor" stroke="none"/>',
  clock:    '<circle cx="10" cy="10" r="7"/><path d="M10 5.9V10l2.8 1.7"/>',
  filter:   '<path d="M3.4 5h13.2l-5.2 6v4.6l-2.8 1.4V11z"/>',
  back:     '<path d="M16.4 10H4.2"/><path d="m8.8 5.4-4.6 4.6 4.6 4.6"/>',
  layers:   '<path d="m10 3 6.8 3.6L10 10.2 3.2 6.6z"/><path d="m3.2 10.6 6.8 3.6 6.8-3.6"/>',
  file:     '<path d="M11.3 2.9H6.1a1.3 1.3 0 0 0-1.3 1.3v11.6a1.3 1.3 0 0 0 1.3 1.3h7.8a1.3 1.3 0 0 0 1.3-1.3V6.7z"/><path d="M11.3 2.9v3.8h3.9"/>',
  activity: '<path d="M2.9 10h3.2l2.1-5.3 3.4 10.6 2.1-5.3h3.4"/>',
  cog:      '<circle cx="10" cy="10" r="2.4"/><path d="M15.9 12.1a1.3 1.3 0 0 0 .3 1.5l.1.1a1.6 1.6 0 1 1-2.2 2.2l-.1-.1a1.3 1.3 0 0 0-1.5-.3 1.3 1.3 0 0 0-.8 1.2v.2a1.6 1.6 0 0 1-3.2 0v-.1a1.3 1.3 0 0 0-.9-1.2 1.3 1.3 0 0 0-1.5.3l-.1.1A1.6 1.6 0 1 1 3.8 13.7l.1-.1a1.3 1.3 0 0 0 .3-1.5 1.3 1.3 0 0 0-1.2-.8h-.2a1.6 1.6 0 1 1 0-3.2h.1a1.3 1.3 0 0 0 1.2-.9 1.3 1.3 0 0 0-.3-1.5l-.1-.1a1.6 1.6 0 1 1 2.2-2.2l.1.1a1.3 1.3 0 0 0 1.5.3h.1a1.3 1.3 0 0 0 .8-1.2v-.2a1.6 1.6 0 0 1 3.2 0v.1a1.3 1.3 0 0 0 .8 1.2 1.3 1.3 0 0 0 1.5-.3l.1-.1a1.6 1.6 0 1 1 2.2 2.2l-.1.1a1.3 1.3 0 0 0-.3 1.5v.1a1.3 1.3 0 0 0 1.2.8h.2a1.6 1.6 0 0 1 0 3.2h-.1a1.3 1.3 0 0 0-1.2.8z"/>',
  sliders:  '<path d="M4.4 16.2V11M4.4 7.8V3.8M10 16.2v-6.4M10 6.6V3.8M15.6 16.2v-3.8M15.6 9.2V3.8"/><path d="M2.4 11h4M8 6.6h4M13.6 12.4h4"/>',
  gauge:    '<path d="M4.1 14.4a7 7 0 1 1 11.8 0"/><path d="m10 10.6 3-3.1"/>',
  euro:     '<path d="M14.2 5.4a5.4 5.4 0 1 0 0 9.2"/><path d="M3.9 8.9h6.6M3.9 11.4h6.6"/>',
  battery:  '<rect x="2.6" y="6.6" width="12.2" height="6.8" rx="1.7"/><path d="M17.4 9.1v1.8"/><path d="M5.6 9.1v1.8M8.4 9.1v1.8"/>',
  check:    '<path d="m4.8 10.4 3.5 3.4 6.9-7.6"/>',
  link:     '<path d="M8.6 11.4a3 3 0 0 0 4.5.3l1.9-1.9a3 3 0 0 0-4.3-4.3l-1.1 1.1"/><path d="M11.4 8.6a3 3 0 0 0-4.5-.3L5 10.2a3 3 0 0 0 4.3 4.3l1.1-1.1"/>',
};
const ic = (n, s = 18, sw = 1.6) =>
  `<svg width="${s}" height="${s}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${P[n]}</svg>`;

/* Suite parent-brand mark — placeholder isotype (no Suite logo exists yet) */
const suiteMark = (s = 26) => `
<svg width="${s}" height="${s}" viewBox="0 0 28 28" fill="none" aria-hidden="true">
  <defs><linearGradient id="sm" x1="4" y1="24" x2="24" y2="4" gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color="#06B6D4"/><stop offset=".55" stop-color="#2563EB"/><stop offset="1" stop-color="#1D4ED8"/>
  </linearGradient></defs>
  <rect x="1" y="1" width="26" height="26" rx="8" fill="url(#sm)"/>
  <path d="M14 6.6 21.6 11 14 15.4 6.4 11z" fill="#fff" fill-opacity=".95"/>
  <path d="m7.6 14.6 6.4 3.7 6.4-3.7" stroke="#fff" stroke-opacity=".7" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="m7.6 18.4 6.4 3.7 6.4-3.7" stroke="#fff" stroke-opacity=".45" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

/* ── attribution + coverage helpers ─────────────────────────── */
const SB = "#2563EB", RN = "#AF47B2", SU = "#06B6D4";
const src = (which) => {
  if (which === "storebrid") return `<span class="src"><i style="background:${SB}"></i>StoreBrid</span>`;
  if (which === "revenew")   return `<span class="src"><i style="background:${RN}"></i>Revenew</span>`;
  if (which === "suite")     return `<span class="src"><i style="background:${SU}"></i>Suite</span>`;
  return `<span class="src"><span class="pair"><i style="background:${SB}"></i><i style="background:${RN}"></i></span>Combined</span>`;
};
const cov = (sb, rn) =>
  `<span style="display:inline-flex;gap:6px">
     <span class="cov${sb ? "" : " off"}"><i style="background:${SB}"></i>StoreBrid</span>
     <span class="cov${rn ? "" : " off"}"><i style="background:${RN}"></i>Revenew</span>
   </span>`;
const badge = (text, color, tint) =>
  `<span class="badge" style="background:${tint};color:${color}"><i style="background:${color}"></i>${text}</span>`;
const ST = {
  active:      badge("Active", "#0E9469", "rgba(16,185,129,.11)"),
  development: badge("Development", "#9A6208", "rgba(245,158,11,.12)"),
  draft:       badge("Draft", "#5B4BB5", "rgba(139,92,246,.12)"),
};

/* ─────────────────────────────────────────────────────────────
   PAGE WRAPPER — one .dc.html per artboard
   ───────────────────────────────────────────────────────────── */
const doc = ({ w, h, side, body, overlay, extraCss }) => `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>${CSS}${extraCss || ""}</style>
</helmet>
<div class="atmos" style="width:${w}px;min-height:${h}px;position:relative">
  <div class="shell" style="min-height:${h}px">
    <aside class="side">${side}</aside>
    <main class="main">
      <div class="focus"></div>
      <div class="content">${body}</div>
    </main>
  </div>
  ${overlay || ""}
</div>
</x-dc>
<script data-dc-script data-props='{"$preview":{"width":${w},"height":${h}}}'>
class Component extends DCLogic {}
</script>
</body>
</html>
`;

const brand = () => `
<div class="brand">
  ${suiteMark(26)}
  <div>
    <div class="brand-name">Sunveon</div>
    <div class="brand-sub">Suite</div>
  </div>
</div>`;

const userChip = () => `
<div style="display:flex;align-items:center;gap:9px;padding:9px 10px;margin-top:8px;border-radius:10px;
            background:rgba(255,255,255,.42);border:1px solid rgba(37,99,235,.07)">
  <span style="width:26px;height:26px;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;
               background:linear-gradient(140deg,#2563EB,#06B6D4);color:#fff;font-size:10px;font-weight:700;letter-spacing:.02em">VA</span>
  <span style="min-width:0">
    <span style="display:block;font-size:12px;font-weight:600;color:var(--s900);line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Victor Andújar</span>
    <span style="display:block;font-size:10px;color:var(--s400);line-height:1.3;margin-top:1px">Sunveon Energy</span>
  </span>
  <span style="margin-left:auto;color:var(--s400);display:flex">${ic("down", 14, 1.7)}</span>
</div>`;

/* Suite-root navigation. The Workspace group (Engineering / Commercial) is
   project-scoped — it appears in the project sidebar, not here, so a user with
   no active project is never shown a group with nothing behind it (§39.7). */
const rootSide = (active) => `
${brand()}
<div class="rule" style="margin-top:16px"></div>
<nav class="nav">
  <a href="#" class="${active === "home" ? "on" : ""}">${ic("home", 17)}Home</a>
  <a href="#" class="${active === "projects" ? "on" : ""}">${ic("projects", 17)}Projects</a>
  <a href="#" class="${active === "analytics" ? "on" : ""}">${ic("analytics", 17)}Analytics</a>
</nav>
<div class="grp">Applications</div>
<nav class="nav">
  <a href="#"><span style="width:17px;display:flex;justify-content:center"><i style="width:6px;height:6px;border-radius:50%;background:${SB};display:block"></i></span>StoreBrid<span style="margin-left:auto;color:var(--s400);display:flex">${ic("upRight", 13, 1.8)}</span></a>
  <a href="#"><span style="width:17px;display:flex;justify-content:center"><i style="width:6px;height:6px;border-radius:50%;background:${RN};display:block"></i></span>Revenew<span style="margin-left:auto;color:var(--s400);display:flex">${ic("upRight", 13, 1.8)}</span></a>
</nav>
<div style="flex:1"></div>
<div class="rule"></div>
<nav class="nav">
  <a href="#">${ic("sliders", 17)}Administration</a>
</nav>
${userChip()}`;

/* Page header card — context label, title, actions right; breadcrumb outside */
const header = ({ crumb, eyebrow, title, meta, actions, hero }) => `
${crumb ? `<div class="crumb">${crumb}</div>` : ""}
<section class="l1${hero ? " hero" : ""}" style="padding:20px 24px;display:flex;align-items:flex-start;gap:24px">
  <div style="flex:1;min-width:0">
    ${eyebrow ? `<p class="eyebrow">${eyebrow}</p>` : ""}
    <h1 class="t-page">${title}</h1>
    ${meta ? `<p class="t-body" style="margin-top:8px;color:var(--s500)">${meta}</p>` : ""}
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex:none;padding-top:${eyebrow ? "14" : "2"}px">${actions}</div>
</section>`;

P.sun = '<circle cx="10" cy="10" r="3.6"/><path d="M10 2.6v1.7M10 15.7v1.7M15.2 4.8l-1.2 1.2M6 14l-1.2 1.2m10.4 0L14 14M6 6 4.8 4.8M17.4 10h-1.7M4.3 10H2.6"/>';

/* ═══════════════════════════════════════════════════════════════
   SCREEN 1 — Suite Home · dual-licence
   §13.2 — Home becomes a Suite-level portfolio summary
   ═══════════════════════════════════════════════════════════════ */
const coverageBar = () => {
  const seg = (n, bg, first, last) =>
    `<span style="flex:${n};height:10px;background:${bg};display:block;
      border-radius:${first ? "5px 2px 2px 5px" : last ? "2px 5px 5px 2px" : "2px"}"></span>`;
  return `
  <div style="display:flex;gap:2px;margin-top:16px">
    ${seg(11, `linear-gradient(90deg,${SB},${RN})`, true, false)}
    ${seg(5, SB, false, false)}
    ${seg(8, RN, false, true)}
  </div>
  <div style="display:flex;gap:18px;margin-top:11px;flex-wrap:wrap">
    ${[
      ["Connected", 11, `linear-gradient(90deg,${SB},${RN})`],
      ["StoreBrid only", 5, SB],
      ["Revenew only", 8, RN],
    ].map(([l, n, bg]) => `
      <span style="display:inline-flex;align-items:center;gap:7px">
        <i style="width:9px;height:5px;border-radius:3px;background:${bg};display:block;flex:none"></i>
        <span class="t-meta" style="font-size:12px;color:var(--s500)">${l}</span>
        <b style="font-size:12px;font-weight:600;color:var(--s900)">${n}</b>
      </span>`).join("")}
  </div>`;
};

const miniTile = ({ label, value, sub, source, accent }) => `
<div class="l3" style="padding:16px 18px 14px;flex:1;min-width:0">
  <div style="display:flex;align-items:center;gap:7px">
    <span style="width:14px;height:14px;flex:none;display:flex;color:${accent || "transparent"}">${ic("alert", 14, 1.7)}</span>
    <span class="kpi-lab">${label}</span>
  </div>
  <div style="font-size:24px;font-weight:700;letter-spacing:-.025em;color:var(--s900);line-height:1.15;margin-top:5px">${value}</div>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:9px">
    <span class="t-meta">${sub}</span>${source}
  </div>
</div>`;

const projectCard = ({ name, place, spec, icon, sb, rn, when }) => `
<a href="#" class="l1" style="padding:18px;display:flex;flex-direction:column;gap:0;text-decoration:none">
  <div style="display:flex;align-items:flex-start;justify-content:space-between">
    <span class="l3" style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;
          border-radius:10px;color:var(--blue700)">${ic(icon, 18)}</span>
    <span style="color:var(--s400);display:flex">${ic("upRight", 15, 1.8)}</span>
  </div>
  <div class="t-card" style="margin-top:14px">${name}</div>
  <div class="t-body" style="color:var(--s500);font-size:13px;margin-top:4px">${place} · ${spec}</div>
  <div style="height:1px;background:var(--hair);margin:14px 0 12px"></div>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
    ${cov(sb, rn)}<span class="t-meta">${when}</span>
  </div>
</a>`;

const activityRow = ({ what, project, source, when, last }) => `
<div style="display:flex;align-items:center;gap:14px;height:52px;padding:0 20px;${last ? "" : "border-bottom:1px solid var(--hair)"}">
  <span style="flex:1;min-width:0;font-size:13px;color:var(--s700);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${what}</span>
  <a href="#" style="width:150px;flex:none;font-size:13px;font-weight:500">${project}</a>
  <span style="width:100px;flex:none">${source}</span>
  <span class="t-meta" style="width:74px;flex:none;text-align:right">${when}</span>
</div>`;

const perfRow = ({ label, value, source, tinted, formula }) => `
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:10px;
     border:1px solid ${tinted ? "rgba(6,182,212,.2)" : "transparent"};
     ${tinted ? "background:linear-gradient(158deg,rgba(6,182,212,.11),rgba(6,182,212,.05))" : ""}">
  <span style="min-width:0">
    <span style="display:block;font-size:13px;font-weight:500;color:var(--s700)">${label}</span>
    ${formula ? `<span class="t-meta" style="display:block;margin-top:4px;font-size:10.5px">${formula}</span>` : ""}
    <span style="display:block;margin-top:5px">${source}</span>
  </span>
  <b style="font-size:${tinted ? "20" : "18"}px;font-weight:700;letter-spacing:-.02em;color:var(--s900);white-space:nowrap">${value}</b>
</div>`;

const home = doc({
  w: 1440, h: 1040, side: rootSide("home"),
